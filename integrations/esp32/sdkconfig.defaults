# Project defaults for the on-device harvest (#579). idf.py applies these
# before writing sdkconfig, so a fresh clone reproduces the harvest build
# without a menuconfig pass.

# The main task runs the whole harvest -- the Unity cases and every benchmark
# arm -- on its own stack, and the deepest chain in it is the trie descent
# inside expanse_map_insert. ESP-IDF's default of 3584 bytes is not enough on
# Xtensa: the windowed-register ABI spills a register window per call level,
# so the same descent that fits comfortably on RV32 runs the ESP32 main task
# off the end of its stack and into the adjacent DRAM. What that corrupts is
# the TLSF free-list metadata of the heap next to it, so the failure surfaces
# later and elsewhere -- a StoreProhibited inside insert_free_block on some
# subsequent allocation, with a backtrace pointing at the allocator rather
# than at the overflow. Measured on hardware: see the stack_min_free_bytes
# line the app prints at the end of a run for the margin this leaves.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The Unity cases are the harvest's gate: no number is trusted from a boot
# whose cases did not run. Keep the IDF test runner on explicitly rather than
# relying on it defaulting on.
CONFIG_UNITY_ENABLE_IDF_TEST_RUNNER=y

# Three of those cases assert lengths with TEST_ASSERT_EQUAL_UINT64. Unity
# compiles its 64-bit comparisons out unless UNITY_SUPPORT_64 is set, and
# then fails the assertion at run time with "Unity 64-bit Support Disabled"
# rather than skipping it -- so without this the gate reports 3 failures that
# say nothing about the engine.
CONFIG_UNITY_ENABLE_64BIT=y

# The engine ships as a release-profile staticlib, but the C glue around it
# (the memtable and tracker wrappers, and the benchmark runner itself) is
# built by ESP-IDF, whose default is -Og. Harvesting under that default
# measures a debug build of everything on the near side of the C ABI: it was
# worth ~1.5x on the ingest arm here. Optimise, so the published numbers
# describe the code a consumer would actually ship.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The interrupt watchdog stays on; the *task* watchdog is turned off for this
# app, because what it watches for is this app's whole purpose.
#
# The harvest runs every Unity case and every benchmark arm on the main task,
# compute-bound, without yielding. IDLE0 therefore never gets scheduled to feed
# the task watchdog, and it fires on a 5 s period for the length of the sweep:
# ~16 times in an 82 s run, each printing a multi-line backtrace over the UART
# *while arms are being timed*.
#
# Two costs, both measured on hardware. It corrupts output: one firing landed
# mid-line in a benchmark's JSON row, and the harvester dropped that row, so an
# arm reported 9 repetitions instead of 10 -- deterministically, in the same
# cell, across two captures. And it perturbs what it interrupts: a watchdog ISR
# plus six lines of 115200-baud UART inside a timed window is exactly the
# contamination `esp32_bench_harvest.py`'s CONTAMINATION_RATIO exists to catch.
#
# Nothing is lost by disabling it. A hung task in a benchmark harness that runs
# to a printed sentinel is visible as a missing sentinel, and the interrupt
# watchdog (CONFIG_ESP_INT_WDT) still covers a genuinely wedged core.
CONFIG_ESP_TASK_WDT_INIT=n
