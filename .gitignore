# Build output
/target
/fuzz/target
# expanse-hot-bench is detached from the workspace and builds into its own
# target dirs; the second one holds the diagnostic `occ-stats` build.
crates/expanse-hot-bench/target/
crates/expanse-hot-bench/target-occ-stats/
bindings/java/target/
bindings/java/build/
bindings/java/.gradle/

# Fuzzing corpora and crash artifacts: regenerated by the fuzzer and
# cached by CI. A crash worth keeping becomes a named regression test,
# not a committed blob.
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Original Judy reference PDFs — design context only, never committed
# (clean-room implementation; see CLAUDE.md and docs/COMPAT.md)
/references/

# Packaging build artifacts
/debian_build/
/rpm_build/
/dist/
/package/
__pycache__/
*.pyc
*.so
*.dylib
*.dll
/integrations/rocksdb/build/
/docs/benchmarks/llm_inference/data/*.bin

# Cached hardware/ISA reference manuals (large, re-downloadable; see docs/HARDWARE.md §7)
/docs/research/hardware/

# Quick-mode (--quick) smoke output of the comparative benchmark suites —
# scratch data only; committed baselines live in results/ proper (#374)
docs/benchmarks/*/results/quick/

# Local git worktrees
/.worktrees/

# Local agent metadata / plans
/.claude/
/scratch/

integrations/stm32h747/*.elf
integrations/stm32h747/*.map
integrations/stm32h747/*.attrs
integrations/stm32h747/transcript*
integrations/qemu-cortex-m3/*.elf
integrations/qemu-cortex-m3/*.map
integrations/qemu-cortex-m3/*.attrs
integrations/qemu-cortex-m3/qemu.out
integrations/esp32/build/
# Per-target build trees and configs, for keeping an Xtensa and a RISC-V
# target flashed side by side without either `set-target` clobbering the
# other (integrations/esp32/README.md).
integrations/esp32/build.*/
integrations/esp32/sdkconfig
integrations/esp32/sdkconfig.*
# ... except the tracked project defaults, which are an input, not an artifact.
!integrations/esp32/sdkconfig.defaults
integrations/esp32/dependencies.lock
integrations/esp32/managed_components/
integrations/stm32h747/demo/Makefile/CM7/build/
