<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Package Metadata -->
    <PackageId>Orieg.Expanse</PackageId>
    <Title>Expanse.NET</Title>
    <Description>High-performance, cache-line-tuned modern Judy arrays and off-heap zero-GC associative collections for .NET 8.0 and .NET 9.0+ powered by libexpanse.</Description>
    <Version>0.3.0</Version>
    <PackageVersion>0.3.0</PackageVersion>
    <AssemblyVersion>0.3.0</AssemblyVersion>
    <Authors>Nicolas Brousse</Authors>
    <Company>Orieg</Company>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/orieg/expanse</PackageProjectUrl>
    <RepositoryUrl>https://github.com/orieg/expanse.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>trie;map;bitset;blobmap;concurrency;lock-free;high-performance;native;interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2255;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
