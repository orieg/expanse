<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Package Metadata -->
    <PackageId>OriEg.Expanse</PackageId>
    <Version>0.3.0</Version>
    <Authors>Nicolas</Authors>
    <Company>OriEg</Company>
    <Description>High-performance native trie, word map, binary key map, off-heap slab blob map, and concurrent collections with lock-free readers for .NET via libexpanse.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/orieg/expanse</PackageProjectUrl>
    <RepositoryUrl>https://github.com/orieg/expanse.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>trie;map;bitset;blobmap;concurrency;lock-free;high-performance;native;interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2255;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
