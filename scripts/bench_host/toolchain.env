# scripts/bench_host/toolchain.env — the toolchain the self-hosted bench
# runners' service account is provisioned with (docs/CI.md, "Bare-Metal
# Benchmark Runner", "Toolchain parity"). Sourced by provision.sh.
#
# The Rust toolchains, iai-callgrind-runner and stock libjudy reproduce what
# the login accounts that ran the runners had when the service account was
# introduced, so a comparison does not change with the account. valgrind does
# not: the login's 3.23.0 is below the floor main enforces, and the pin follows
# the hosted Callgrind jobs instead. Changing a value here is a
# toolchain change on the instrument, not a convenience: a published figure
# measured before it is not comparable with one measured after (AGENTS.md §8.7).

# Rust. The stable toolchain is the default; rustc 1.98.1 is commit 48a229ce.
RUST_STABLE=1.98.1
# The dated nightly whose rustc is commit a69a63265 (commit date 2026-09-03),
# the nightly the reference host had. No bench workflow asks for a nightly by
# channel name; one that does fails when rustup cannot write RUSTUP_HOME, and
# names this pin as the toolchain to add.
RUST_NIGHTLY=nightly-2026-09-04
RUST_NIGHTLY_COMPONENTS="rust-src"

# The runner binary for iai-callgrind: must equal the `iai-callgrind` version in
# Cargo.lock, which `provision.sh check` compares.
IAI_CALLGRIND_RUNNER=0.16.1

# valgrind, built from the release tarball into the toolchain prefix: the
# release and checksum .github/actions/valgrind pins for the hosted Callgrind
# jobs, so the reference host and CI count with the same build. It must be at
# least 3.24.0, the floor bench_baremetal.yml enforces (valgrind bug 492663,
# #1216: earlier releases can read no symbols for a PIE and count 0).
VALGRIND_VERSION=3.27.1
VALGRIND_URL=https://sourceware.org/pub/valgrind/valgrind-3.27.1.tar.bz2
VALGRIND_SHA256=5d589152eb8071c02feab8ce6ab719e431a1fbc3e2b1700f5432632a8b9264dc

# Stock libjudy: the exact shared object the published stock comparisons were
# measured against is copied, not rebuilt, and refused if its hash differs.
LIBJUDY_SONAME=libJudy.so.1.0.3
LIBJUDY_SHA256=0423c1bb484c979608abb384227d7181e2cb36e1efee7866873b79ed0e19ba0e
# Its header, installed alongside it by the same build, pinned the same way:
# it lands on C_INCLUDE_PATH for every later build.
LIBJUDY_HEADER_SHA256=41223ab2750b712f8128aa2e14bb05461f268a7d16f5ce123b9b5be213d2e2d8
