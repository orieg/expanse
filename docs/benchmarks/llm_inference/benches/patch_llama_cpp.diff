# Patch for llama.cpp (pinned commit: b3560 / master)
# Integrates Expanse C++20 str_map into common/ngram-cache.cpp
--- a/common/ngram-cache.cpp
+++ b/common/ngram-cache.cpp
@@ -1,5 +1,6 @@
 #include "ngram-cache.h"
 #include "llama.h"
+#include "expanse.hpp"
 
 #include <algorithm>
 #include <cstdint>
@@ -10,13 +11,35 @@
 #include <unordered_map>
 #include <vector>
 
-// N-Gram lookup cache using std::unordered_map
-struct llama_ngram_cache {
-    std::unordered_map<std::string, std::unordered_map<llama_token, int32_t>> map;
-    int32_t ngram_min = 1;
-    int32_t ngram_max = 4;
-};
+// Encodes 1..4 tokens into 7-bit NUL-free byte sequences
+static inline std::string encode_tokens_7bit(const llama_token* tokens, size_t n) {
+    std::string s;
+    s.reserve(n * 3);
+    for (size_t i = 0; i < n; ++i) {
+        uint32_t tok = static_cast<uint32_t>(tokens[i]);
+        s.push_back(static_cast<char>(((tok >> 14) & 0x7F) + 1));
+        s.push_back(static_cast<char>(((tok >> 7) & 0x7F) + 1));
+        s.push_back(static_cast<char>((tok & 0x7F) + 1));
+    }
+    return s;
+}
+
+// Expanse-accelerated N-Gram Lookup Cache using expanse::str_map
+struct llama_ngram_cache {
+    expanse::str_map<uint64_t> map;
+    int32_t ngram_min = 1;
+    int32_t ngram_max = 4;
+
+    void update(const llama_token* tokens, size_t pos) {
+        llama_token next_tok = tokens[pos];
+        for (int32_t n = ngram_min; n <= ngram_max; ++n) {
+            if (static_cast<int32_t>(pos) < n) break;
+            std::string key = encode_tokens_7bit(&tokens[pos - n], n);
+            std::string full_key = key + encode_tokens_7bit(&next_tok, 1);
+            uint64_t cnt = map.get(full_key).value_or(0);
+            map.insert(full_key, cnt + 1);
+        }
+    }
+};
