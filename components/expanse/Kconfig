menu "Expanse Embedded Digital Trie"

    config EXPANSE_SRAM_INTERNAL_ONLY
        bool "Force Expanse allocations into internal fast DRAM (MALLOC_CAP_INTERNAL)"
        default y
        help
            When enabled, Expanse trie nodes and leaves are allocated exclusively
            from internal high-speed DRAM rather than external SPI PSRAM, maximizing
            cache line throughput and eliminating bus arbitration latency.

    config EXPANSE_DEFAULT_CHUNK_SIZE
        int "Default embedded slab chunk size (bytes)"
        default 2048
        range 512 65536
        help
            Chunk allocation size for BlobArena32 in embedded microcontroller workloads.

endmenu
