{
 "suite": "census_subdigit_baseline_callgrind",
 "refs": "#1610; docs/benchmarks/concurrency/METHODOLOGY.md section 54",
 "measured": "2026-11-08 (UTC)",
 "base": "d882511c9 (main)",
 "what": "Callgrind profile of every instructions and rmw_instructions arm at the base, with each arm's total as its base, and, from a census build of the same tree, per arm: the census marks optimistic writers make (Shared::mark_dirty_digit calls), the dirty top-level digits the with_locked fold refolds, how many of those children skip level 7 or are not branches (refolded whole after the change too), and how many level-7 children the others hold (what the change reads exactly or refolds by bucket). For each arm with any: the base fold's recursion into dirty children (fold_branch_pop0 called from fold_branch_pop0_selective), and the fold calls themselves.",
 "provenance": {
  "host": {
   "machine": "development laptop, Apple M-series, macOS",
   "role": "not the reference benchmark host; Callgrind counts are deterministic",
   "container": "docker --platform linux/amd64 --security-opt seccomp=unconfined (x86_64 emulation)"
  },
  "image": {
   "name": "cg86:local",
   "valgrind": "3.24.0",
   "rustc": "1.99.1",
   "iai_callgrind_runner": "0.16.1, matching iai-callgrind 0.16.1 in Cargo.lock"
  },
  "commands": [
   "git archive d882511c9 into a fresh directory, with a fresh CARGO_TARGET_DIR",
   "CARGO_PROFILE_BENCH_DEBUG=1 cargo bench -p expanse-trie --bench instructions --bench rmw_instructions",
   "census build: the same tree, with #[inline(never)] marker functions of distinct bodies called once per Shared::mark_dirty_digit, once per dirty top-level child the selective fold refolds, once more for such a child that is not a branch at level 7, and once per level-7 child of the others; the markers' calls= counts per arm",
   "each arm's callgrind out parsed per (caller, callee) call edge"
  ],
  "estimators": {
   "base": "the arm's total Ir in the base profile",
   "n_marks": "Shared::mark_dirty_digit calls in the measured region (each marker call is 3 Ir; counts are the markers' inclusive Ir / 3, because a calls= count includes the setup's calls)",
   "n_dirty_top": "dirty top-level children the fold refolded",
   "n_dirty_whole": "of those, children that are not a branch at level 7: refolded whole after the change",
   "n_scan": "level-7 children of the other dirty top-level children",
   "fold_rec_ir / fold_rec_calls": "fold_branch_pop0 called from fold_branch_pop0_selective: inclusive Ir and calls",
   "fold_calls": "fold_branch_pop0_selective calls from outside itself (one per with_locked fold)"
  }
 },
