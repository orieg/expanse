{
 "suite": "branchb_empty_baseline_callgrind",
 "refs": "#1610; docs/benchmarks/concurrency/METHODOLOGY.md section 53",
 "measured": "2026-11-08 (UTC)",
 "base": "d882511c9 (main)",
 "what": "Callgrind profile of every instructions and rmw_instructions arm at the base, with each arm's total as its base, and, from a census build of the same tree, how many of the arm's removals empty a child under a BranchB and where: at its floor (still a fallback after the change) or above it, by the subarray case the change would take (in place, across a capacity class, or the subexpanse's last edge). For each arm that has any: the exclusive remove's calls from outside the engine's recursion and their inclusive Ir.",
 "provenance": {
  "host": {
   "machine": "development laptop, Apple M-series, macOS",
   "role": "not the reference benchmark host; Callgrind counts are deterministic",
   "container": "docker --platform linux/amd64 --security-opt seccomp=unconfined (x86_64 emulation)"
  },
  "image": {
   "name": "cg86:local",
   "valgrind": "3.24.0",
   "rustc": "1.99.1",
   "iai_callgrind_runner": "0.16.1, matching iai-callgrind 0.16.1 in Cargo.lock"
  },
  "commands": [
   "git archive d882511c9 into a fresh directory, with a fresh CARGO_TARGET_DIR",
   "CARGO_PROFILE_BENCH_DEBUG=1 cargo bench -p expanse-trie --bench instructions --bench rmw_instructions",
   "census build: the same tree, with each of the six sites that fall back on an emptied child calling, under a BranchB parent, one of four #[inline(never)] marker functions with distinct bodies (floor; above the floor and in place; across a class; the subexpanse's last edge); the markers' calls= counts per arm",
   "each arm's callgrind out parsed per function and per (caller, callee) call edge"
  ],
  "estimators": {
   "base": "the arm's total Ir in the base profile (the in-region count iai-callgrind reports)",
   "n_floor": "removals that would bring a BranchB to BRANCHB_TO_L7_DOWN digits: they stay fallbacks",
   "n_switch_*": "removals the change takes optimistically, by subarray case",
   "excl_ir / excl_calls": "the exclusive remove (map_remove_occ / remove_occ) called from the wrapper or host, inclusive Ir per call, over every fallback of the arm"
  },
  "wrapper_measurement": {
   "arm": "instructions sync_map_remove/random and sync_map_churn/random",
   "remove_tree_self_ir": {
    "sync_map_remove": 12456713,
    "sync_map_churn": 6553124
   },
   "removes": 50000,
   "fallbacks": 34940,
   "per_fallback_ir": 168.9636233543217,
   "note": "SyncExpanseMap::remove_tree's own instructions in the remove arm, less the churn arm's (whose 50,000 removals are all optimistic), over the remove arm's fallbacks: the serialised wrapper's instructions per fallback"
  }
